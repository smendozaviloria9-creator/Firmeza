FROM mcr.microsoft.com/dotnet/sdk:10.0 AS test
WORKDIR /app

# 1. Copiar solucion y proyectos para restaurar dependencias
COPY Firmeza.sln .
COPY src/Firmeza.Domain/Firmeza.Domain.csproj src/Firmeza.Domain/
COPY src/Firmeza.Application/Firmeza.Application.csproj src/Firmeza.Application/
COPY src/Firmeza.Infrastructure/Firmeza.Infrastructure.csproj src/Firmeza.Infrastructure/
COPY src/Firmeza.Api/Firmeza.Api.csproj src/Firmeza.Api/
COPY src/Firmeza.Web/Firmeza.Web.csproj src/Firmeza.Web/
COPY src/Firmeza.Tests/Firmeza.Tests.csproj src/Firmeza.Tests/

# 2. Restaurar dependencias de pruebas
RUN dotnet restore src/Firmeza.Tests/Firmeza.Tests.csproj

# 3. Copiar codigo fuente
COPY src/ src/

# 4. Ejecutar pruebas unitarias automatizadas
ENTRYPOINT ["dotnet", "test", "src/Firmeza.Tests/Firmeza.Tests.csproj", "-c", "Release", "--logger", "console;verbosity=normal"]
