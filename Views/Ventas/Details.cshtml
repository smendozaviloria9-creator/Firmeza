@model Firmeza.Web.Models.Venta

<h2>Venta N° @Model.Id</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<dl class="row">
    <dt class="col-sm-2">Fecha</dt>
    <dd class="col-sm-10">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-2">Cliente</dt>
    <dd class="col-sm-10">@Model.Cliente?.Nombres @Model.Cliente?.Apellidos (@Model.Cliente?.Documento)</dd>
</dl>

<h5>Productos</h5>
<table class="table">
    <thead>
    <tr>
        <th>Producto</th>
        <th>Cantidad</th>
        <th>Precio unitario</th>
        <th>Subtotal</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var detalle in Model.Detalles)
    {
        <tr>
            <td>@detalle.Producto?.Nombre</td>
            <td>@detalle.Cantidad</td>
            <td>@detalle.PrecioUnitario.ToString("C")</td>
            <td>@detalle.Subtotal.ToString("C")</td>
        </tr>
    }
    </tbody>
</table>

<div class="text-end">
    <p>Subtotal: @Model.Subtotal.ToString("C")</p>
    <p>IVA (19%): @Model.Iva.ToString("C")</p>
    <p><strong>Total: @Model.Total.ToString("C")</strong></p>
</div>

<div class="mt-3">
    @if (!string.IsNullOrEmpty(Model.ReciboArchivo))
    {
        <a asp-action="DescargarRecibo" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            Descargar recibo (PDF)
        </a>
    }
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>