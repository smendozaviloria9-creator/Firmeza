@{
    ViewData["Title"] = "Importar datos desde Excel";
}

<h2>Importar datos desde Excel</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Index" enctype="multipart/form-data" method="post" class="mt-3">
    <div class="mb-3">
        <label class="form-label">Archivo Excel (.xlsx)</label>
        <input type="file" name="archivo" class="form-control" accept=".xlsx" required />
    </div>
    <button type="submit" class="btn btn-primary">Importar</button>
</form>

<div class="alert alert-info mt-4">
    <strong>Formato esperado (columnas, en cualquier orden):</strong><br />
    <code>ClienteNombres, ClienteApellidos, ClienteDocumento, ClienteCorreo, ClienteTelefono, ClienteDireccion, ClienteEdad, ProductoNombre, ProductoDescripcion, ProductoCategoria, ProductoUnidadMedida, ProductoPrecio, ProductoStock, VentaCantidad, VentaFecha</code>
</div>