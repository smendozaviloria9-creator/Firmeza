<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Firmeza</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="d-flex" id="wrapper">
            <!-- Sidebar -->
            <nav class="firmeza-sidebar d-flex flex-column p-3 text-white">
                <a href="/" class="d-flex align-items-center mb-4 text-white text-decoration-none">
                    <i class="bi bi-bricks fs-3 me-2"></i>
                    <span class="fs-4 fw-bold">Firmeza</span>
                </a>
                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item">
                        <a href="/Home/Index" class="nav-link text-white">
                            <i class="bi bi-speedometer2 me-2"></i> Inicio
                        </a>
                    </li>
                    <li>
                        <a href="/Productos" class="nav-link text-white">
                            <i class="bi bi-box-seam me-2"></i> Productos
                        </a>
                    </li>
                    <li>
                        <a href="/Clientes" class="nav-link text-white">
                            <i class="bi bi-people me-2"></i> Clientes
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Ventas" asp-action="Index" class="nav-link text-white">
                            <i class="bi bi-cart me-2"></i> Ventas
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Importacion" asp-action="Index" class="nav-link text-white">
                            <i class="bi bi-file-earmark-arrow-up me-2"></i> Importación
                        </a>
                    </li>
                </ul>
                <hr class="text-white-50">
                <div class="dropdown">
                    <span class="d-flex align-items-center text-white text-decoration-none small">
                        <i class="bi bi-person-circle me-2 fs-5"></i>
                        @User.Identity!.Name
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light btn-sm w-100">
                            <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                        </button>
                    </form>
                </div>
            </nav>

            <!-- Contenido -->
            <div class="flex-grow-1">
                <header class="firmeza-header d-flex align-items-center justify-content-between px-4 py-3 border-bottom bg-white">
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </header>
                <main class="p-4">
                    @if (TempData["Mensaje"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Mensaje"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </main>
                <footer class="text-center text-muted small py-3 border-top">
                    &copy; @DateTime.Now.Year - Firmeza · Materiales de construcción
                </footer>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
