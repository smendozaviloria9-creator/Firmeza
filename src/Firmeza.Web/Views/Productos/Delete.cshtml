@model Producto
@{
    ViewData["Title"] = "Eliminar producto";
}
<div class="card p-4" style="max-width:600px;">
    <h5 class="text-danger">¿Confirmas eliminar este producto?</h5>
    <dl class="row mt-3">
        <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Nombre</dd>
        <dt class="col-sm-4">Categoría</dt><dd class="col-sm-8">@Model.Categoria</dd>
        <dt class="col-sm-4">Stock</dt><dd class="col-sm-8">@Model.Stock</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
