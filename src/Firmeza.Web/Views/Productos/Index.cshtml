@model IEnumerable<Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <form method="get" class="d-flex gap-2">
        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por nombre o descripción..." />
        <select name="categoria" class="form-select">
            <option value="">Todas las categorías</option>
            @foreach (var cat in (List<string>)ViewBag.Categorias)
            {
                <option value="@cat" selected="@(cat == (string)ViewBag.Categoria)">@cat</option>
            }
        </select>
        <button type="submit" class="btn btn-outline-dark"><i class="bi bi-search"></i></button>
    </form>
    <a asp-controller="Exportacion" asp-action="ProductosExcel" class="btn btn-outline-success">
        <i class="bi bi-file-earmark-excel"></i> Exportar Excel
    </a>
    <a asp-controller="Exportacion" asp-action="ProductosPdf" class="btn btn-outline-danger">
        <i class="bi bi-file-earmark-pdf"></i> Exportar PDF
    </a>
    <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus-lg me-1"></i> Nuevo producto</a>
</div>

<div class="table-responsive">
    <table class="table table-hover bg-white align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Unidad</th>
                <th class="text-end">Precio</th>
                <th class="text-end">Stock</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Nombre</td>
                    <td>@p.Categoria</td>
                    <td>@p.UnidadMedida</td>
                    <td class="text-end">@p.PrecioUnitario.ToString("C")</td>
                    <td class="text-end">@p.Stock</td>
                    <td>
                        @if (p.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No se encontraron productos.</td></tr>
            }
        </tbody>
    </table>
</div>
