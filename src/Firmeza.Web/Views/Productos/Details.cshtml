@model Producto
@{
    ViewData["Title"] = "Detalle del producto";
}
<div class="card p-4" style="max-width:600px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Nombre</dd>
        <dt class="col-sm-4">Descripción</dt><dd class="col-sm-8">@Model.Descripcion</dd>
        <dt class="col-sm-4">Categoría</dt><dd class="col-sm-8">@Model.Categoria</dd>
        <dt class="col-sm-4">Unidad de medida</dt><dd class="col-sm-8">@Model.UnidadMedida</dd>
        <dt class="col-sm-4">Precio unitario</dt><dd class="col-sm-8">@Model.PrecioUnitario.ToString("C")</dd>
        <dt class="col-sm-4">Stock</dt><dd class="col-sm-8">@Model.Stock</dd>
        <dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@(Model.Activo ? "Activo" : "Inactivo")</dd>
        <dt class="col-sm-4">Creado</dt><dd class="col-sm-8">@Model.FechaCreacion.ToLocalTime()</dd>
    </dl>
    <a asp-action="Index" class="btn btn-outline-secondary mt-3">Volver</a>
</div>
