@model IEnumerable<Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <form method="get" class="d-flex gap-2">
        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por nombre o documento..." />
        <button type="submit" class="btn btn-outline-dark"><i class="bi bi-search"></i></button>
    </form>
    <a asp-controller="Exportacion" asp-action="ClientesExcel" class="btn btn-outline-success">
        <i class="bi bi-file-earmark-excel"></i> Exportar Excel
    </a>
    <a asp-controller="Exportacion" asp-action="ClientesPdf" class="btn btn-outline-danger">
        <i class="bi bi-file-earmark-pdf"></i> Exportar PDF
    </a>
    <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus-lg me-1"></i> Nuevo cliente</a>
</div>

<div class="table-responsive">
    <table class="table table-hover bg-white align-middle">
        <thead>
            <tr>
                <th>Nombre completo</th>
                <th>Documento</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th class="text-end">Edad</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Nombres @c.Apellidos</td>
                    <td>@c.Documento</td>
                    <td>@c.Correo</td>
                    <td>@c.Telefono</td>
                    <td class="text-end">@c.Edad</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No se encontraron clientes.</td></tr>
            }
        </tbody>
    </table>
</div>
