@model IEnumerable<Venta>
@{
    ViewData["Title"] = "Ventas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Ventas</h2>
    <div class="d-flex gap-2">
        <a asp-controller="Exportacion" asp-action="VentasExcel" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel"></i> Exportar Excel
        </a>
        <a asp-controller="Exportacion" asp-action="VentasPdf" class="btn btn-outline-danger">
            <i class="bi bi-file-earmark-pdf"></i> Exportar PDF
        </a>
        <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus-lg me-1"></i> Nueva venta</a>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<div class="table-responsive">
    <table class="table table-hover bg-white align-middle">
        <thead>
        <tr>
            <th>N°</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th class="text-end">Total</th>
            <th class="text-end">Acciones</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var venta in Model)
        {
            <tr>
                <td>@venta.Id</td>
                <td>@venta.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@venta.Cliente?.Nombres @venta.Cliente?.Apellidos</td>
                <td class="text-end">@venta.Total.ToString("C")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@venta.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                    <a asp-action="Delete" asp-route-id="@venta.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted py-4">No se encontraron ventas.</td></tr>
        }
        </tbody>
    </table>
</div>
