@model Firmeza.Web.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-metric p-3">
            <span class="text-muted small">Productos</span>
            <span class="display-6">@Model.TotalProductos</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-metric p-3">
            <span class="text-muted small">Clientes</span>
            <span class="display-6">@Model.TotalClientes</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-metric p-3">
            <span class="text-muted small">Ventas</span>
            <span class="display-6">@Model.TotalVentas</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-metric p-3">
            <span class="text-muted small">Monto total vendido</span>
            <span class="display-6">@Model.MontoTotalVentas.ToString("C")</span>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <a asp-controller="Productos" asp-action="Index" class="text-decoration-none">
            <div class="card card-metric p-4">
                <i class="bi bi-box-seam fs-2 mb-2"></i>
                <h5>Gestionar productos</h5>
                <p class="text-muted mb-0">Crear, editar, buscar y eliminar productos del catálogo.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a asp-controller="Clientes" asp-action="Index" class="text-decoration-none">
            <div class="card card-metric p-4">
                <i class="bi bi-people fs-2 mb-2"></i>
                <h5>Gestionar clientes</h5>
                <p class="text-muted mb-0">Registrar y actualizar la información de los clientes.</p>
            </div>
        </a>
    </div>
</div>
